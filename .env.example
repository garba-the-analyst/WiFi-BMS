# Copy to .env (never commit it). Used by docker-compose.yml.
PUBLIC_HOST=wifi.waste2light.com
OWNER_DB_PASSWORD=change-me-long-random
APP_DB_PASSWORD=change-me-another-long-random
# 64 hex characters: openssl rand -hex 32. Losing it makes stored Paystack keys unreadable. Back it up offline.
PLATFORM_MASTER_KEY=

# 2-step verification by email and SMS (optional; the authenticator app always works)
SMTP_URL=
MAIL_FROM=
TERMII_API_KEY=
TERMII_SENDER_ID=

# Single-machine mode only (docker-compose.tunnel.yml): the token from Cloudflare Zero Trust -> Networks -> Tunnels
TUNNEL_TOKEN=
# Leave unset. 0 only for the first-run bootstrap while the tunnel is OFF (docs/single-box.md)
#REQUIRE_2FA=1
