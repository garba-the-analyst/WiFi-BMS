# One host, one certificate:
#   https://wifi.waste2light.com/        customer portal (captive portal, plans, member area)
#   https://wifi.waste2light.com/admin   staff back office (same app; every /v1/.../admin call needs an at_ token)
#   https://wifi.waste2light.com/v1/*    the API
{
	servers {
		# The domain is proxied by Cloudflare, so the TCP peer is Cloudflare. Trust its published ranges
		# and read the visitor's real address from CF-Connecting-IP. Anyone else's header is ignored.
		# Check these against https://www.cloudflare.com/ips/ when you deploy and now and then after.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# API. Only /v1 and the health check reach the application container.
	@api path /v1/* /healthz
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else is the web app. Unknown paths fall back to index.html so /admin/customers etc. work on reload.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@volatile path /config.json /index.html
		header @volatile Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
