# Copy to /etc/wifi-bms/site-agent.env (chmod 600, owner wifibms).
# Central platform (HTTPS required)
CENTRAL_URL=https://api.example.com
NODE_TOKEN=nt_replace_with_token_from_admin_panel
# Shared secret FreeRADIUS sends in X-Agent-Key (16+ chars)
LOCAL_KEY=change-me-to-a-long-random-string
LISTEN=127.0.0.1:8081
SPOOL_PATH=/var/lib/wifi-bms/spool.jsonl
# Router CoA/Disconnect (RouterOS: /radius incoming accept=yes port=3799)
RADCLIENT_BIN=radclient
COA_ADDR=192.168.88.1:3799
COA_SECRET=router-radius-secret
# Optional DHCP hints for device identification (RouterOS v7 REST)
#ROUTER_REST_URL=https://192.168.88.1
#ROUTER_USER=agent
#ROUTER_PASS=change-me
RUST_LOG=info
